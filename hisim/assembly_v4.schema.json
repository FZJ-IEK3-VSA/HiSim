{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assembly_v4.schema.json",
  "title": "HiSim assembly, schema version 4 (lean v1)",
  "description": "A fragment of an energy system in a file of its own (assemblies_spec.md \u00a713.1): members, parameters, exactly_one_of constraints, internal variants, an interface of ports and its test contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "name",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "kind": {
      "const": "assembly"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(/[A-Za-z_][A-Za-z0-9_]*)+$"
    },
    "description": {
      "type": "string"
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "allOf": [
          {
            "$ref": "#/$defs/name"
          },
          {
            "not": {
              "enum": [
                "priorities"
              ]
            }
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "components": {
      "$ref": "#/$defs/members"
    },
    "variants": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/variant"
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "needs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/port"
          }
        },
        "provides": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/port"
          }
        },
        "observes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/port"
          }
        }
      }
    },
    "tests": {
      "$ref": "#/$defs/tests"
    }
  },
  "if": {
    "required": [
      "parameters"
    ],
    "properties": {
      "parameters": {
        "not": {
          "additionalProperties": {
            "not": {
              "properties": {
                "type": {
                  "enum": [
                    "float",
                    "int"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "tests": {
        "properties": {
          "monotone": {
            "minItems": 1
          }
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$"
    },
    "source": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$"
    },
    "default_inputs": {
      "$ref": "#/$defs/name"
    },
    "explicit_wire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "from"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "aggregator_feed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "tags"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/source"
        },
        "component_type": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weight": {
          "type": "integer"
        },
        "dispatch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_input": {
              "$ref": "#/$defs/name"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "input_item": {
      "oneOf": [
        {
          "$ref": "#/$defs/default_inputs"
        },
        {
          "$ref": "#/$defs/explicit_wire"
        },
        {
          "$ref": "#/$defs/aggregator_feed"
        },
        {
          "$ref": "#/$defs/port_placeholder"
        }
      ]
    },
    "string_or_param": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "$param"
          ],
          "maxProperties": 1
        }
      ]
    },
    "sizing_sources": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/reference"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            }
          }
        ]
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partner": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          ]
        },
        "into": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          ]
        },
        "wires": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/name"
          }
        },
        "output": {
          "$ref": "#/$defs/reference"
        },
        "controllable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_input": {
              "$ref": "#/$defs/name"
            },
            "via": {
              "$ref": "#/$defs/name"
            },
            "optional": {
              "type": "boolean"
            }
          },
          "oneOf": [
            {
              "required": [
                "target_input"
              ]
            },
            {
              "required": [
                "via"
              ],
              "not": {
                "required": [
                  "optional"
                ]
              }
            }
          ]
        },
        "circuit": {
          "$ref": "#/$defs/name"
        },
        "member": {
          "oneOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/name"
              }
            }
          ]
        },
        "carrier": {
          "enum": [
            "electricity",
            "natural_gas",
            "heating_oil",
            "pellets",
            "wood_chips",
            "hydrogen",
            "diesel",
            "district_heat",
            "space_heating_heat",
            "domestic_hot_water_heat",
            "cooling",
            "ambient_heat",
            "solar"
          ]
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "meter": {
          "$ref": "#/$defs/name"
        },
        "fact": {
          "$ref": "#/$defs/name"
        },
        "many": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/selection"
        },
        "optional": {
          "type": "boolean"
        },
        "required_when": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1
          }
        },
        "active_when": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/name"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "port_placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$port"
      ],
      "properties": {
        "$port": {
          "$ref": "#/$defs/name"
        }
      }
    },
    "selection": {
      "oneOf": [
        {
          "const": "declared"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "component_type": {
                "oneOf": [
                  {
                    "enum": [
                      "PV",
                      "WINDTURBINE",
                      "SMART_DEVICE",
                      "SURPLUS_CONTROLLER",
                      "SURPLUS_CONTROLLER_DISTRICT",
                      "PREDICTIVE_CONTROLLER",
                      "HEAT_PUMP",
                      "GAS_HEATER",
                      "OIL_HEATER",
                      "PELLET_HEATER",
                      "WOOD_CHIP_HEATER",
                      "HYDROGEN_HEATER",
                      "DISTRICT_HEATING",
                      "BATTERY",
                      "CAR_BATTERY",
                      "CAR",
                      "FUEL_CELL",
                      "ELECTROLYZER",
                      "TRANSFORMER_AND_RECTIFIER",
                      "CHP",
                      "H2_STORAGE",
                      "ELECTRIC_VEHICLE",
                      "ELECTRIC_HEATER",
                      "ELECTRIC_HEATING_SH",
                      "ELECTRIC_HEATING_DHW",
                      "BOILER",
                      "BUFFER",
                      "THERMAL_ENERGY_STORAGE",
                      "SPACE_HEATING_STORAGE",
                      "DOMESTIC_HOT_WATER_STORAGE",
                      "HEATERS",
                      "RESIDENTS",
                      "BUILDINGS",
                      "SOLAR_THERMAL_SYSTEM",
                      "ELECTRICITY_METER",
                      "GAS_METER",
                      "ENERGY_MANAGEMENT_SYSTEM",
                      "HEAT_DISTRIBUTION_SYSTEM_FLOORHEATING",
                      "HEAT_DISTRIBUTION_SYSTEM_RADIATOR",
                      "HEAT_DISTRIBUTION_SYSTEM_LOW_TEMPERATURE_RADIATOR",
                      "NO_HDS",
                      "WALL_EXTERNAL_INSULATION",
                      "WALL_INTERNAL_INSULATION",
                      "ROOF_INSULATION_BETWEEN_JOISTS",
                      "ROOF_INSULATION_OVER_JOISTS",
                      "WARM_ROOF_INSULATION",
                      "TOP_CEILING_UPPER_INSULATION",
                      "BASEMENT_CEILING_BOTTOM_INSULATION",
                      "BASEMENT_WALLS_INTERNAL_INSULATION",
                      "GROUND_EXTERNAL_INSULATION",
                      "WINDOWS_TRIPLE_GLAZED",
                      "EXTERIOR_DOOR",
                      "AIR_SEALING",
                      "VENTILATION_SYSTEM",
                      "HEAT_PUMP_BUILDING",
                      "HEAT_PUMP_DHW"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "PV",
                        "WINDTURBINE",
                        "SMART_DEVICE",
                        "SURPLUS_CONTROLLER",
                        "SURPLUS_CONTROLLER_DISTRICT",
                        "PREDICTIVE_CONTROLLER",
                        "HEAT_PUMP",
                        "GAS_HEATER",
                        "OIL_HEATER",
                        "PELLET_HEATER",
                        "WOOD_CHIP_HEATER",
                        "HYDROGEN_HEATER",
                        "DISTRICT_HEATING",
                        "BATTERY",
                        "CAR_BATTERY",
                        "CAR",
                        "FUEL_CELL",
                        "ELECTROLYZER",
                        "TRANSFORMER_AND_RECTIFIER",
                        "CHP",
                        "H2_STORAGE",
                        "ELECTRIC_VEHICLE",
                        "ELECTRIC_HEATER",
                        "ELECTRIC_HEATING_SH",
                        "ELECTRIC_HEATING_DHW",
                        "BOILER",
                        "BUFFER",
                        "THERMAL_ENERGY_STORAGE",
                        "SPACE_HEATING_STORAGE",
                        "DOMESTIC_HOT_WATER_STORAGE",
                        "HEATERS",
                        "RESIDENTS",
                        "BUILDINGS",
                        "SOLAR_THERMAL_SYSTEM",
                        "ELECTRICITY_METER",
                        "GAS_METER",
                        "ENERGY_MANAGEMENT_SYSTEM",
                        "HEAT_DISTRIBUTION_SYSTEM_FLOORHEATING",
                        "HEAT_DISTRIBUTION_SYSTEM_RADIATOR",
                        "HEAT_DISTRIBUTION_SYSTEM_LOW_TEMPERATURE_RADIATOR",
                        "NO_HDS",
                        "WALL_EXTERNAL_INSULATION",
                        "WALL_INTERNAL_INSULATION",
                        "ROOF_INSULATION_BETWEEN_JOISTS",
                        "ROOF_INSULATION_OVER_JOISTS",
                        "WARM_ROOF_INSULATION",
                        "TOP_CEILING_UPPER_INSULATION",
                        "BASEMENT_CEILING_BOTTOM_INSULATION",
                        "BASEMENT_WALLS_INTERNAL_INSULATION",
                        "GROUND_EXTERNAL_INSULATION",
                        "WINDOWS_TRIPLE_GLAZED",
                        "EXTERIOR_DOOR",
                        "AIR_SEALING",
                        "VENTILATION_SYSTEM",
                        "HEAT_PUMP_BUILDING",
                        "HEAT_PUMP_DHW"
                      ]
                    }
                  }
                ]
              },
              "flow": {
                "oneOf": [
                  {
                    "enum": [
                      "MASS_FLOW",
                      "CONTROL_SIGNAL",
                      "ELECTRICITY_TARGET",
                      "LAST_ACTIVATION",
                      "LATEST_ACTIVATION",
                      "EARLIEST_ACTIVATION",
                      "RECOMMENDED_ACTIVATION",
                      "ELECTRICITY_PRODUCTION",
                      "ELECTRICITY_INJECTION",
                      "ELECTRICITY_CONSUMPTION",
                      "ELECTRICITY_CONSUMPTION_EMS_CONTROLLED",
                      "ELECTRICITY_CONSUMPTION_UNCONTROLLED",
                      "STORAGE_CONTENT",
                      "CHARGE_DISCHARGE",
                      "CHARGE",
                      "DISCHARGE",
                      "GAS_PRODUCTION",
                      "GAS_CONSUMPTION_UNCONTROLLED",
                      "HEAT_DELIVERED",
                      "HEAT_CONSUMPTION",
                      "HEAT_TO_BUILDING",
                      "HEAT_TO_BUFFER",
                      "THERMAL_PRODUCTION",
                      "FUEL_CONSUMPTION",
                      "WATER_HEATING",
                      "HEATING"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "enum": [
                        "MASS_FLOW",
                        "CONTROL_SIGNAL",
                        "ELECTRICITY_TARGET",
                        "LAST_ACTIVATION",
                        "LATEST_ACTIVATION",
                        "EARLIEST_ACTIVATION",
                        "RECOMMENDED_ACTIVATION",
                        "ELECTRICITY_PRODUCTION",
                        "ELECTRICITY_INJECTION",
                        "ELECTRICITY_CONSUMPTION",
                        "ELECTRICITY_CONSUMPTION_EMS_CONTROLLED",
                        "ELECTRICITY_CONSUMPTION_UNCONTROLLED",
                        "STORAGE_CONTENT",
                        "CHARGE_DISCHARGE",
                        "CHARGE",
                        "DISCHARGE",
                        "GAS_PRODUCTION",
                        "GAS_CONSUMPTION_UNCONTROLLED",
                        "HEAT_DELIVERED",
                        "HEAT_CONSUMPTION",
                        "HEAT_TO_BUILDING",
                        "HEAT_TO_BUFFER",
                        "THERMAL_PRODUCTION",
                        "FUEL_CONSUMPTION",
                        "WATER_HEATING",
                        "HEATING"
                      ]
                    }
                  }
                ]
              },
              "output": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/name"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/name"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default",
        "description"
      ],
      "properties": {
        "type": {
          "enum": [
            "float",
            "int",
            "bool",
            "enum",
            "string"
          ]
        },
        "unit": {
          "enum": [
            "ANY",
            "PERCENT",
            "FRACTION",
            "WATT",
            "KILOWATT",
            "KWH_PER_TIMESTEP",
            "WATT_PER_METER",
            "WATT_PER_SQUARE_METER",
            "WATT_HOUR_PER_SQUARE_METER",
            "METER_PER_SECOND",
            "METER",
            "SQUARE_METER",
            "WATT_HOUR",
            "KWH",
            "JOULE",
            "KILOJOULE",
            "LITER",
            "CUBICMETERS",
            "LITER_PER_TIMESTEP",
            "CUBICMETERS_PER_SECOND",
            "KG",
            "KG_PER_SEC",
            "CELSIUS",
            "KELVIN",
            "DEGREES",
            "BAR",
            "PASCAL",
            "SECONDS",
            "HOURS",
            "TIMESTEPS",
            "YEARS",
            "EUR_PER_KWH",
            "EURO",
            "BINARY"
          ]
        },
        "default": {},
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "float",
                  "int"
                ]
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactly_one_of"
      ],
      "properties": {
        "exactly_one_of": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string"
        },
        "preset": {
          "$ref": "#/$defs/string_or_param"
        },
        "constructor": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1
        },
        "config": {
          "type": "object"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_item"
          }
        },
        "sizing_sources": {
          "$ref": "#/$defs/sizing_sources"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "members": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/member"
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_by",
        "options"
      ],
      "properties": {
        "selected_by": {
          "$ref": "#/$defs/name"
        },
        "options": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when"
            ],
            "properties": {
              "when": {
                "type": "array",
                "minItems": 1
              },
              "components": {
                "$ref": "#/$defs/members"
              }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bounds"
          }
        },
        "monotone": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/monotone"
          }
        },
        "expect": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expect"
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "output": {
          "$ref": "#/$defs/reference"
        },
        "kpi": {
          "type": "string"
        },
        "member": {
          "$ref": "#/$defs/name"
        },
        "unit": {
          "enum": [
            "ANY",
            "PERCENT",
            "FRACTION",
            "WATT",
            "KILOWATT",
            "KWH_PER_TIMESTEP",
            "WATT_PER_METER",
            "WATT_PER_SQUARE_METER",
            "WATT_HOUR_PER_SQUARE_METER",
            "METER_PER_SECOND",
            "METER",
            "SQUARE_METER",
            "WATT_HOUR",
            "KWH",
            "JOULE",
            "KILOJOULE",
            "LITER",
            "CUBICMETERS",
            "LITER_PER_TIMESTEP",
            "CUBICMETERS_PER_SECOND",
            "KG",
            "KG_PER_SEC",
            "CELSIUS",
            "KELVIN",
            "DEGREES",
            "BAR",
            "PASCAL",
            "SECONDS",
            "HOURS",
            "TIMESTEPS",
            "YEARS",
            "EUR_PER_KWH",
            "EURO",
            "BINARY"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "oneOf": [
        {
          "required": [
            "output",
            "unit"
          ],
          "not": {
            "required": [
              "member"
            ]
          }
        },
        {
          "required": [
            "kpi"
          ]
        }
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    },
    "monotone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter",
        "kpi",
        "direction"
      ],
      "properties": {
        "parameter": {
          "$ref": "#/$defs/name"
        },
        "kpi": {
          "type": "string"
        },
        "member": {
          "$ref": "#/$defs/name"
        },
        "direction": {
          "enum": [
            "increasing",
            "decreasing",
            "constant"
          ]
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kpi"
      ],
