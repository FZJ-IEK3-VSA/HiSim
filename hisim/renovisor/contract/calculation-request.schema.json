{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renovisor.climatemedia.de/schemas/calculation-request/1.json",
  "title": "RenoVisor calculation request",
  "description": "One house inventory plus one list of measures — one simulation. Sparse: a field is present only when the frontend set it; the backend defaults the rest and reports every default. Unknown keys and unknown enum values are refused (422), never ignored. The body is the cache key: nothing in it identifies the submission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "location", "house", "measures", "applicant"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "location": {
      "$ref": "#/$defs/location"
    },
    "house": {
      "$ref": "#/$defs/house"
    },
    "applicant": {
      "$ref": "#/$defs/applicant"
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      },
      "description": "Empty for the baseline. Each id at most once."
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country"],
      "properties": {
        "country": {
          "enum": ["IE", "ES", "NL"],
          "description": "ISO 3166-1 alpha-2. Selects the weather (Weather.for_location) and the TABULA country."
        },
        "postcode": {
          "type": "string",
          "maxLength": 16
        }
      }
    },
    "house": {
      "type": "object",
      "additionalProperties": false,
      "required": ["building", "occupancy", "heating", "heat_distribution"],
      "properties": {
        "building": {
          "$ref": "#/$defs/building"
        },
        "occupancy": {
          "$ref": "#/$defs/occupancy"
        },
        "heating": {
          "$ref": "#/$defs/heating"
        },
        "heat_distribution": {
          "$ref": "#/$defs/heat_distribution"
        },
        "hot_water": {
          "$ref": "#/$defs/hot_water"
        },
        "ventilation": {
          "$ref": "#/$defs/ventilation"
        },
        "temperature_control": {
          "$ref": "#/$defs/temperature_control"
        },
        "air_conditioning": {
          "$ref": "#/$defs/air_conditioning"
        },
        "appliances": {
          "$ref": "#/$defs/appliances"
        },
        "pv_system": {
          "$ref": "#/$defs/pv_system"
        },
        "battery": {
          "$ref": "#/$defs/battery"
        },
        "solar_thermal_system": {
          "$ref": "#/$defs/solar_thermal_system"
        },
        "electric_vehicles": {
          "$ref": "#/$defs/electric_vehicles"
        }
      }
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "building_type",
        "construction_year",
        "absolute_conditioned_floor_area_in_m2",
        "set_heating_temperature_in_celsius",
        "roof",
        "facade",
        "floor",
        "window",
        "door"
      ],
      "properties": {
        "building_type": {
          "enum": [
            "detached_sfh",
            "semi_detached_sfh",
            "terraced_sfh",
            "bungalow",
            "apartment",
            "other"
          ]
        },
        "construction_year": {
          "type": "integer",
          "minimum": 1700,
          "maximum": 2100
        },
        "living_area_in_m2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "The dwelling's living area in m², for the cost lines that scale with it. Absent: the conditioned floor area stands in and is reported defaulted."
        },
        "absolute_conditioned_floor_area_in_m2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Heated living area (HiSim Building field, verbatim)."
        },
        "number_of_storeys": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "set_heating_temperature_in_celsius": {
          "type": "number",
          "minimum": 12,
          "maximum": 28,
          "description": "HiSim Building field, verbatim. The measure change_room_temperature overwrites it."
        },
        "tabula_building_code": {
          "type": "string",
          "pattern": "^[A-Z]{2}\\.N\\.(SFH|TH|MFH|AB)\\.[0-9]{2}\\.Gen\\.ReEx\\.[0-9]{3}\\.[0-9]{3}$",
          "description": "Expert override. When absent the backend derives it from country, building_type and construction_year."
        },
        "roof": {
          "$ref": "#/$defs/roof"
        },
        "facade": {
          "$ref": "#/$defs/facade"
        },
        "floor": {
          "$ref": "#/$defs/floor"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "door": {
          "$ref": "#/$defs/door"
        }
      }
    },
    "u_value": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10,
      "description": "W/(m²·K), as the frontend derived it from its country pack. Written to Building.<element>_u_value_in_watt_per_m2_per_kelvin verbatim; a measure's added layer lowers it in apply()."
    },
    "installation_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100,
      "description": "The year the existing asset was installed. Economics only — it dates the like-for-like replacement and the sunk-cost credit. Absent: the building's construction year stands in and is reported defaulted."
    },
    "area": {
      "type": "number",
      "minimum": 0,
      "description": "Envelope area in m². Absent: the TABULA archetype's area scaled to the conditioned floor area."
    },
    "added_insulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placement", "thickness_in_mm", "material"],
      "description": "An insulation layer a measure adds to an element. Written by apply(); never sent by the frontend directly.",
      "properties": {
        "placement": {
          "enum": [
            "external_wall_internal",
            "external_wall_cavity",
            "external_wall_external",
            "roof_under_rafter",
            "roof_between_rafter",
            "roof_external_rafter",
            "top_floor_ceiling",
            "floor_and_ceiling",
            "basement_ceiling",
            "basement_floor_and_walls_inside",
            "basement_floor_and_walls_outside"
          ],
          "description": "materials.yaml building_components vocabulary, verbatim."
        },
        "thickness_in_mm": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "air_barrier": {
          "type": "boolean"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asp_id", "thermal_conductivity_w_mk"],
      "description": "Physical properties copied out of materials.yaml by the frontend, field names verbatim from that file; the backend reads no catalogue. asp_id is provenance for the mapping report.",
      "properties": {
        "asp_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "thermal_conductivity_w_mk": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "heat_capacity_j_kgk": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "density_kg_m3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "One number: the midpoint of the file's {min, max} range."
        },
        "co2_footprint_a1_a3_c3_c4_kg_m2": {
          "type": "number",
          "description": "EN 15804+A2, per m² at the thickness for U = 0.3."
        },
        "lifespan_years": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "roof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u_value_in_watt_per_m2_per_kelvin"],
      "description": "The frontend derives the U-value from its country pack (construction + insulation ids); the backend takes W/(m²·K) and knows no country ids.",
      "properties": {
        "u_value_in_watt_per_m2_per_kelvin": {
          "$ref": "#/$defs/u_value"
        },
        "area_in_m2": {
          "$ref": "#/$defs/area"
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        },
        "shape": {
          "enum": ["pitched", "flat"],
          "description": "Sets the PV and solar-thermal tilt."
        },
        "added_insulation": {
          "$ref": "#/$defs/added_insulation"
        }
      }
    },
    "facade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u_value_in_watt_per_m2_per_kelvin"],
      "properties": {
        "u_value_in_watt_per_m2_per_kelvin": {
          "$ref": "#/$defs/u_value"
        },
        "area_in_m2": {
          "$ref": "#/$defs/area"
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        },
        "added_insulation": {
          "$ref": "#/$defs/added_insulation"
        }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u_value_in_watt_per_m2_per_kelvin"],
      "properties": {
        "u_value_in_watt_per_m2_per_kelvin": {
          "$ref": "#/$defs/u_value"
        },
        "area_in_m2": {
          "$ref": "#/$defs/area"
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        },
        "added_insulation": {
          "$ref": "#/$defs/added_insulation"
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u_value_in_watt_per_m2_per_kelvin", "glazing_panes"],
      "properties": {
        "u_value_in_watt_per_m2_per_kelvin": {
          "$ref": "#/$defs/u_value"
        },
        "glazing_panes": {
          "enum": [1, 2, 3],
          "description": "The measure window_replacement overwrites it and the U-value with it."
        },
        "frame_material": {
          "enum": ["wood", "plastic", "metal", "composite"]
        },
        "low_emissivity_coating": {
          "type": "boolean"
        },
        "area_in_m2": {
          "$ref": "#/$defs/area"
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        },
        "outside_shading": {
          "type": "boolean"
        },
        "thermocover": {
          "type": "boolean"
        }
      }
    },
    "door": {
      "type": "object",
      "additionalProperties": false,
      "required": ["u_value_in_watt_per_m2_per_kelvin"],
      "properties": {
        "u_value_in_watt_per_m2_per_kelvin": {
          "$ref": "#/$defs/u_value"
        },
        "glazing_panes": {
          "enum": [0, 2, 3]
        },
        "frame_material": {
          "enum": ["wood", "plastic", "metal", "composite"]
        },
        "area_in_m2": {
          "$ref": "#/$defs/area"
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        }
      }
    },
    "occupancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number_of_residents"],
      "properties": {
        "number_of_residents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "home_office_days_per_week": {
          "type": "number",
          "minimum": 0,
          "maximum": 7
        },
        "pv_self_consumption_optimised": {
          "type": "boolean",
          "description": "Set by the measure optimize_behaviour_for_self_consumption_of_pv."
        }
      }
    },
    "heating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_of_system"],
      "properties": {
        "type_of_system": {
          "description": "The values of measure heating_system.type_of_system, plus solid_fuel_heating which exists only as a current system.",
          "enum": [
            "air_source_heat_pump",
            "ground_source_heat_pump",
            "hybrid_heat_pump",
            "electric_heating",
            "biomass_heating",
            "pellet_heating",
            "woodchip_heating",
            "district_heating",
            "hvo_heating",
            "hydrogen_heating",
            "conventional_gas_heating",
            "conventional_oil_heating",
            "conventional_lpg_heating",
            "condensing_gas_heating",
            "condensing_oil_heating",
            "condensing_lpg_heating",
            "solid_fuel_heating"
          ]
        },
        "cooking_range": {
          "type": "boolean",
          "description": "The generator is a cooking range (Irish range cooker) — replaces the former *_cooking_range ids."
        },
        "secondary": {
          "enum": ["open_fireplace", "wood_stove", "electric_heater"]
        },
        "flow_temperature_in_celsius": {
          "type": "number",
          "minimum": 20,
          "maximum": 90,
          "description": "HiSim heat-pump field, verbatim."
        },
        "seasonal_efficiency_in_percent": {
          "type": "number",
          "minimum": 1,
          "maximum": 400
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        },
        "heatpump_scop_en14825_w35": {
          "type": "number",
          "exclusiveMinimum": 1,
          "maximum": 10,
          "description": "Seasonal coefficient of performance of the heat pump in the house, as rated under EN 14825 for the low-temperature application (35 °C water outlet, W35), average climate: the datasheet or ErP fiche's 'low temperature' column. The SCOP itself, not the seasonal space-heating efficiency ηs and not a metered seasonal performance factor (JAZ). Only for a heat-pump type_of_system (else refused, heating.scop.not_a_heat_pump); give both ratings where the fiche has both. Omit when unknown."
        },
        "heatpump_scop_en14825_w55": {
          "type": "number",
          "exclusiveMinimum": 1,
          "maximum": 10,
          "description": "The same rating for the medium-temperature application (55 °C water outlet, W55): the fiche's 'medium temperature' column, on every fiche of a heat pump not sold as a low-temperature unit. Everything said for heatpump_scop_en14825_w35 applies; with both given, W55 must not exceed W35 (else refused, heating.scop.w55_above_w35)."
        }
      }
    },
    "heat_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_of_system"],
      "properties": {
        "type_of_system": {
          "enum": ["surface_heating", "low_temperature_radiator", "conventional_radiator"],
          "description": "The values of measure heating_installation.type_of_system."
        }
      }
    },
    "hot_water": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supply"],
      "properties": {
        "supply": {
          "enum": [
            "together_with_heating_system",
            "separate_heat_pump",
            "separate_direct_electric"
          ],
          "description": "The values of measure hot_water_system.supply."
        },
        "volume_heating_water_storage_in_liter": {
          "type": "number",
          "minimum": 0,
          "maximum": 2000,
          "description": "HiSim SimpleDHWStorage field, verbatim."
        },
        "tank_and_pipe_insulated": {
          "type": "boolean",
          "description": "Set by the measure hot_water_tank_and_pipe_insulation."
        }
      }
    },
    "ventilation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type_of_system": {
          "enum": [
            "natural",
            "window_trickle_vent",
            "mechanical_extract",
            "demand_controlled_extract",
            "mechanical_ventilation_with_heat_recovery"
          ],
          "description": "The values of measure ventilation_system.type_of_system plus natural (current systems only)."
        },
        "air_tightness": {
          "enum": ["as_built", "diy_sealed", "professionally_sealed"],
          "description": "diy_sealing_of_air_leaks sets diy_sealed; shallow_air_tightness_measures sets professionally_sealed."
        }
      }
    },
    "temperature_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_of_system"],
      "properties": {
        "type_of_system": {
          "enum": ["traditional_thermostats", "smart_heating_control_system"],
          "description": "The values of measure temperature_control_system.type_of_system."
        }
      }
    },
    "air_conditioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["power_in_watt"],
      "properties": {
        "power_in_watt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50000
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        }
      }
    },
    "appliances": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "white_appliances": {
          "enum": ["existing", "new_efficient"]
        }
      }
    },
    "pv_system": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sized by at least one of power_in_watt or size_in_percent_of_roof_area, and both may be given: the photovoltaic_system measure carries both since contract 882a8c1, because they answer different questions — the share of the roof is about future potential (whether the array can still grow), the watts are what a yield calculation reads. With both, power_in_watt sizes the array and the share is recorded. The measure's options carry the unit suffix (azimuth_in_degree, tilt_in_degree); this block keeps HiSim's field names azimuth and tilt.",
      "anyOf": [
        {
          "required": ["power_in_watt"]
        },
        {
          "required": ["size_in_percent_of_roof_area"]
        }
      ],
      "properties": {
        "power_in_watt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "size_in_percent_of_roof_area": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "azimuth": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "description": "HiSim PVSystem field, verbatim; 180 = south."
        },
        "tilt": {
          "type": "number",
          "minimum": 0,
          "maximum": 90,
          "description": "HiSim PVSystem field, verbatim; degrees from horizontal."
        },
        "shading_losses_in_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Annual generation lost to shading, as a percent of the unshaded array."
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        }
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "description": "Sized by exactly one of custom_battery_capacity_generic_in_kilowatt_hour (the capacity, HiSim field verbatim) or days_to_cover (legacy), with an optional power_in_watt beside either. The battery_system measure carries capacity_in_kwh and power_in_watt since contract 882a8c1 (the frontend converts its days-to-cover question into them) and writes the capacity here; a house block sized by days stays accepted.",
      "oneOf": [
        {
          "required": ["custom_battery_capacity_generic_in_kilowatt_hour"]
        },
        {
          "required": ["days_to_cover"]
        }
      ],
      "properties": {
        "custom_battery_capacity_generic_in_kilowatt_hour": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        },
        "power_in_watt": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "description": "The battery's rated power (HiSim's custom_pv_inverter_power_generic_in_watt). Absent: 0.5 C of the capacity, 500 W per kWh — the catalogue's rule and HiSim's battery's own."
        },
        "days_to_cover": {
          "type": "integer",
          "minimum": 1,
          "maximum": 14,
          "description": "Legacy: how many days of the household's electricity the battery holds, sized against the consumption the run simulates (approximated). The battery_system measure no longer carries it (contract 882a8c1); state the capacity instead. Still accepted, so no existing request breaks."
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        }
      }
    },
    "solar_thermal_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplies"],
      "properties": {
        "supplies": {
          "enum": ["dhw_only", "dhw_and_space_heating"],
          "description": "The values of measure solar_thermal_system.supplies."
        },
        "collector_type": {
          "enum": ["flat_plate", "evacuated_tube"]
        },
        "area_m2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "HiSim SolarThermalSystem field, verbatim (no _in_)."
        },
        "storage_volume_in_liter": {
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "installation_year": {
          "$ref": "#/$defs/installation_year"
        }
      }
    },
    "electric_vehicles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "description": "Home-charged electric cars — the only vehicles that touch the building simulation. Fuel cars are the frontend's own cost/CO₂ arithmetic and are not sent.",
      "properties": {
        "number": {
          "enum": [1, 2],
          "description": "The measure electric_vehicle.number overwrites it."
        },
        "commuting_distance_in_km": {
          "enum": [5, 10, 15, 20, 25, 30]
        },
        "charging_power_in_watt": {
          "enum": [3700, 11000, 22000]
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_in_euro_per_m2", "max_in_euro_per_m2", "source"],
          "description": "The measure's installed-price band in euro per square metre, which prices the envelope subject it creates. The frontend copies it out of materials.yaml's measure_costs; the backend reads no catalogue. The cheap end above the expensive end, a negative or non-finite price is refused (measure.cost.band_invalid).",
          "properties": {
            "min_in_euro_per_m2": {
              "type": "number",
              "minimum": 0
            },
            "max_in_euro_per_m2": {
              "type": "number",
              "minimum": 0,
              "description": "The expensive end of the band, at or above min_in_euro_per_m2 (checked by the backend's semantic rules)."
            },
            "source": {
              "type": "string",
              "description": "Provenance of the band, e.g. the materials.yaml row it was copied from."
            }
          }
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9_]+$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "$ref": "#/$defs/material"
              }
            ]
          }
        }
      },
      "description": "Verbatim {id, options} from measures.yaml, with a material option expanded to its properties. Ids, option names and values are checked by the translation layer's table, not by this schema."
    },
    "applicant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_residence"],
      "description": "Who applies for the subsidy, for the eligibility conditions of the country's catalogue. The block is required and must state main_residence (decision of 2026-09-24); every other key is optional, and a key the block omits stays undetermined, which a scheme reads as a question rather than as a denial. An omitted role defaults to owner_occupier.",
      "properties": {
        "role": {
          "enum": ["owner_occupier", "landlord", "tenant", "condominium_association"],
          "description": "Who signs the funding application. Absent: owner_occupier."
        },
        "receives_means_tested_benefit": {
          "type": "boolean",
          "description": "Whether the applicant draws a means-tested social benefit (Ireland: a qualifying welfare payment)."
        },
        "first_time_buyer": {
          "type": "boolean",
          "description": "Whether the applicant bought this home as their first home."
        },
        "managed_full_retrofit": {
          "type": "boolean",
          "description": "Whether the works are delivered as one managed complete upgrade — Ireland's One Stop Shop route."
        },
        "taxable_household_income_in_euro": {
          "type": "number",
          "minimum": 0,
          "description": "Per year, gross of tax."
        },
        "household_size": {
          "type": "integer",
          "minimum": 1,
          "description": "Persons; some income thresholds scale with it."
        },
        "main_residence": {
          "type": "boolean",
          "description": "Whether the dwelling is the applicant's main residence; required by several bonuses. Required: a request that does not state it is refused, since the answer changes which schemes apply."
        }
      }
    }
  }
}
