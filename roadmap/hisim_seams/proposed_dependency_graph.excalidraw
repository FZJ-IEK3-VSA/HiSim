   "updated": 1762560000000,
   "link": null,
   "locked": false,
   "text": "Decided 2026-11-25: RenoVisor reads\nthe run's KPIs and energy balance\nthrough postprocessing's readers\n(KpiFinder, the balance-report reader). It\nruns through energy_system, not the\nsimulator.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Decided 2026-11-25: RenoVisor reads\nthe run's KPIs and energy balance\nthrough postprocessing's readers\n(KpiFinder, the balance-report reader). It\nruns through energy_system, not the\nsimulator.",
   "lineHeight": 1.15,
   "autoResize": true
  },
