   "link": null,
   "locked": false,
   "text": "Conflict with the code: the document rules inside\nsetup_rules import energy_system.model (13\nstatements). Drawn: setup_rules imports no\nenergy_system; the document-level rules move\ninto energy_system/rules/ and register with the\nengine.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Conflict with the code: the document rules inside\nsetup_rules import energy_system.model (13\nstatements). Drawn: setup_rules imports no\nenergy_system; the document-level rules move\ninto energy_system/rules/ and register with the\nengine.",
   "lineHeight": 1.15,
   "autoResize": true
  },
