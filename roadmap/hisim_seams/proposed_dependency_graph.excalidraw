   "link": null,
   "locked": false,
   "text": "Conflict with the code (simulator): it imports\nsetup_rules (4 statements) for the BUILD hooks\nAddedSystem and BuiltSystem, so Python-mode\nsetups are checked too. Drawn: neutral hook\npoints on the simulator; energy_system (YAML) or\nthe entry point (Python mode) registers the rules.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Conflict with the code (simulator): it imports\nsetup_rules (4 statements) for the BUILD hooks\nAddedSystem and BuiltSystem, so Python-mode\nsetups are checked too. Drawn: neutral hook\npoints on the simulator; energy_system (YAML) or\nthe entry point (Python mode) registers the rules.",
   "lineHeight": 1.15,
   "autoResize": true
  },
