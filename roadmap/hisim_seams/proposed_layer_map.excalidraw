   "seed": 55338125,
   "version": 1,
   "versionNonce": 210722256,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762560000000,
   "link": null,
   "locked": false,
   "text": "imports go down only:\na module imports a layer\nbelow its own, never its\nown layer's siblings and\nnever a layer above.\n\ninside a layer a package\nimports a sibling only\nwhere the map lists it:\nsimulator -> postprocessing\nis the one exception\n(the run calls the\npost-processing).",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "imports go down only:\na module imports a layer\nbelow its own, never its\nown layer's siblings and\nnever a layer above.\n\ninside a layer a package\nimports a sibling only\nwhere the map lists it:\nsimulator -> postprocessing\nis the one exception\n(the run calls the\npost-processing).",
   "lineHeight": 1.15,
   "autoResize": true
  },
  {
   "id": "title",
   "type": "text",
   "x": 30,
   "y": 28,
   "width": 962.7,
   "height": 27.6,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 867999238,
   "version": 1,
   "versionNonce": 163999970,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762560000000,
   "link": null,
   "locked": false,
   "text": "HiSim proposed layer map: eight layers, imports go down only, one public API per package",
   "fontSize": 24,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "HiSim proposed layer map: eight layers, imports go down only, one public API per package",
   "lineHeight": 1.15,
   "autoResize": true
  },
  {
   "id": "subtitle",
   "type": "text",
   "x": 30,
   "y": 62,
   "width": 859.34,
   "height": 41.4,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 687252606,
   "version": 1,
   "versionNonce": 207376334,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762560000000,
   "link": null,
   "locked": false,
   "text": "Proposal of the seams spec (roadmap/hisim_seams_spec.html), not an owner decision. A dashed box is a new or renamed package; every other box exists today.\nThe public API of a package is what its __init__ exports; everything else is internal and the lint refuses an import of it from another package.\nData directories (hisim/inputs, hisim/cost_database, hisim/subsidy_catalog) hold no code and are outside the map.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Proposal of the seams spec (roadmap/hisim_seams_spec.html), not an owner decision. A dashed box is a new or renamed package; every other box exists today.\nThe public API of a package is what its __init__ exports; everything else is internal and the lint refuses an import of it from another package.\nData directories (hisim/inputs, hisim/cost_database, hisim/subsidy_catalog) hold no code and are outside the map.",
   "lineHeight": 1.15,
   "autoResize": true
  }
 ],
 "appState": {
  "viewBackgroundColor": "#ffffff",
  "gridSize": null
 },
 "files": {}
