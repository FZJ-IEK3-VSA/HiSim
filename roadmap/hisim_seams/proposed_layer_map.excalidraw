  },
  {
   "id": "subtitle",
   "type": "text",
   "x": 30,
   "y": 62,
   "width": 993.61,
   "height": 41.4,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 687252606,
   "version": 1,
   "versionNonce": 207376334,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762560000000,
   "link": null,
   "locked": false,
   "text": "Proposal of the seams spec (roadmap/hisim_seams_spec.html), not an owner decision. A dashed box is a new or renamed package; every other box exists today.\nComponents, postprocessing and economics are siblings over one contracts layer; the orchestration layer owns the sequence and hands the frozen run record down to the two consumers.\nData directories (hisim/inputs, hisim/cost_database, hisim/subsidy_catalog) hold no code and are outside the map.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Proposal of the seams spec (roadmap/hisim_seams_spec.html), not an owner decision. A dashed box is a new or renamed package; every other box exists today.\nComponents, postprocessing and economics are siblings over one contracts layer; the orchestration layer owns the sequence and hands the frozen run record down to the two consumers.\nData directories (hisim/inputs, hisim/cost_database, hisim/subsidy_catalog) hold no code and are outside the map.",
   "lineHeight": 1.15,
   "autoResize": true
  }
 ],
